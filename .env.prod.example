# Copy to .env.prod (or set these in Synology Container Manager) before running:
# docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build

POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_CONTAINER_NAME=vibecard-postgres
POSTGRES_DB=vibecard
POSTGRES_USER=vibecard
POSTGRES_PASSWORD=change-me
POSTGRES_DATA_PATH=/volume2/docker/vibecard/postgres

MINIO_IMAGE=minio/minio:latest

MINIO_FAST_CONTAINER_NAME=vibecard-minio-fast
MINIO_FAST_API_PORT=9000
MINIO_FAST_CONSOLE_PORT=9001
MINIO_FAST_DATA_PATH=/volume2/docker/vibecard/minio-fast
MINIO_FAST_ENDPOINT=http://minio-fast:9000
MINIO_FAST_PUBLIC_BASE_URL=https://your-domain.example/minio-fast
MINIO_FAST_ACCESS_KEY=miniofast
MINIO_FAST_SECRET_KEY=change-me-fast
MINIO_FAST_BUCKET=vibecard-fast

MINIO_COLD_CONTAINER_NAME=vibecard-minio-cold
MINIO_COLD_API_PORT=9100
MINIO_COLD_CONSOLE_PORT=9101
MINIO_COLD_DATA_PATH=/volume1/docker/vibecard/minio-cold
MINIO_COLD_ENDPOINT=http://minio-cold:9000
MINIO_COLD_PUBLIC_BASE_URL=https://your-domain.example/minio-cold
MINIO_COLD_ACCESS_KEY=miniocold
MINIO_COLD_SECRET_KEY=change-me-cold
MINIO_COLD_BUCKET=vibecard-cold

BACKEND_CONTAINER_NAME=vibecard-backend
BACKEND_PORT=8080
BACKEND_UPLOADS_PATH=/volume1/docker/vibecard/backend/uploads

SPRING_PROFILES_ACTIVE=prod
DATABASE_URL=jdbc:postgresql://postgres:5432/vibecard
DATABASE_USERNAME=vibecard
DATABASE_PASSWORD=change-me
JPA_DDL_AUTO=update
UPLOAD_DIR=/app/uploads

GOOGLE_CLIENT_ID=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

OPENCLAW_BASE_URL=
OPENCLAW_AUTH_TYPE=bearer
OPENCLAW_AUTH_HEADER=Authorization
OPENCLAW_AUTH_TOKEN=
OPENCLAW_AUTH_TOKEN_OPENCLAW1=
OPENCLAW_AUTH_TOKEN_OPENCLAW2=
OPENCLAW_AUTH_TOKEN_OPENCLAW3=
OPENCLAW_MODE=multi_endpoint
OPENCLAW_CHAT_PATH=/v1/chat/completions
OPENCLAW_MODEL_OPENCLAW1=
OPENCLAW_MODEL_OPENCLAW2=
OPENCLAW_MODEL_OPENCLAW3=
OPENCLAW_MODEL_OPENCLAW3_GENERAL=
OPENCLAW_MODEL_OPENCLAW3_CODING=
OPENCLAW_MODEL_OPENCLAW3_VISION=
OPENCLAW_OLLAMA_URL_OPENCLAW3=
OPENCLAW_OLLAMA_UNLOAD_AFTER_VISION=true
OPENCLAW_URL_OPENCLAW1=
OPENCLAW_URL_OPENCLAW2=
OPENCLAW_URL_OPENCLAW3=

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini
